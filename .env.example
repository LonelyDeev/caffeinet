APP_NAME="کافی‌نت آنلاین"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

# زبان/منطقهٔ زمانی پیش‌فرض (تاریخ‌ها با شمسی morilog/jalali نمایش داده می‌شوند)
# APP_TIMEZONE=Asia/Tehran

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# امنیت (فاز ۱۱)
# ---------------------------------------------------------------------------
# کلید رمزنگاری فایل‌های خصوصی روی دیسک (AES-256-GCM).
# ساخت: php artisan key:generate --show  و سپس یک کلید مستقل ۳۲بایتی:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# بدون مقدار: کلیدِ مشتق از APP_KEY استفاده می‌شود (پایدار و امن).
FILE_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# لاگ — در پروداکشن daily + ۱۴ روز
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_DAYS=14

# ---------------------------------------------------------------------------
# دیتابیس — dev: SQLite / پروداکشن: MySQL (تصمیم مالک)
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=caffeinet
# DB_USERNAME=caffeinet
# DB_PASSWORD=secret
# MYSQL_SSL_MODE=preferred

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=caffeinet

# ---------------------------------------------------------------------------
# اپراتورهای وب‌سرور
# ---------------------------------------------------------------------------
# PHP_CLI_SERVER_WORKERS=4 (برای artisan serve چند-کارگری)

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# S3 (اختیاری — پیش‌فرض فایل‌ها روی دیسک خصوصی محلی رمزنگاری‌شده‌اند)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
